# =====================================================================
# SATELLITUM - Configurações e Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
# cp .env.example .env && chmod 600 .env
# =====================================================================

# Configurações do PostgreSQL
POSTGRES_USER=administrador
POSTGRES_PASSWORD=sua_senha_forte_do_postgres_aqui
POSTGRES_DB=satellitum
DB_HOST=satellitum_db

# Configurações da Aplicação Streamlit
APP_PORT=8502
APP_URL=http://localhost:8502
ADMIN_INITIAL_PASSWORD=sua_senha_inicial_do_admin_aqui

# Configurações do Google Cloud / Earth Engine / Google Drive
GOOGLE_PROJECT_ID=ppgrhs-satellitum
EARTHENGINE_PROJECT=ppgrhs-satellitum
GOOGLE_CLIENT_ID=seu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui

# Diretório de Datasets no Host
DATASETS_DIR=/storage/datasets

# Configurações do pgAdmin (Opcional)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@satellitum.local
PGADMIN_DEFAULT_PASSWORD=sua_senha_forte_do_pgadmin_aqui

